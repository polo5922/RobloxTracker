<UserControl x:Class="RobloxTracker.App.Views.DayDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RobloxTracker.App.Controls">
    <!-- DataContext : DayDetailViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,28">
            <Button Style="{StaticResource GhostButton}" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="-8,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock Text="Retour" Margin="8,0,0,0" />
                </StackPanel>
            </Button>

            <!-- En-tête : date + navigation jour par jour -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding PreviousCommand}" Padding="8" ToolTip="Jour précédent">
                        <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                    </Button>
                    <Button Content="Aujourd'hui" Command="{Binding TodayCommand}" Margin="4,0" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding NextCommand}" Padding="8" ToolTip="Jour suivant">
                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" Margin="0" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtitle}"
                               Visibility="{Binding Subtitle, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding DeltaText}" Margin="0,4,0,0"
                               Visibility="{Binding DeltaText, Converter={StaticResource Vis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeltaUp}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Chiffres clés de la journée -->
            <UniformGrid Columns="4" Margin="-6,12,-6,0">
                <HeaderedContentControl Style="{StaticResource StatCard}" Header="Temps de jeu" Tag="&#xE916;"
                                        Foreground="{StaticResource SuccessBrush}">
                    <TextBlock Text="{Binding Total, Converter={StaticResource Duration}}" Style="{StaticResource BigNumber}" FontSize="21" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource StatCard}" Header="Sessions" Tag="&#xE768;"
                                        Foreground="{StaticResource AccentBrush}">
                    <TextBlock Text="{Binding SessionCount}" Style="{StaticResource BigNumber}" FontSize="21" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource StatCard}" Header="Plus longue session" Tag="&#xE823;"
                                        Foreground="{StaticResource Accent2Brush}">
                    <TextBlock Text="{Binding LongestSession, Converter={StaticResource Duration}}" Style="{StaticResource BigNumber}" FontSize="21" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource StatCard}" Header="Plage horaire" Tag="&#xE787;"
                                        Foreground="{StaticResource OrangeBrush}">
                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource BigNumber}" FontSize="21" />
                </HeaderedContentControl>
            </UniformGrid>

            <!-- Graphe par heure : une heure pleine = 150 px -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Right" Text="échelle : 1 h de jeu par heure" Style="{StaticResource Muted}" FontSize="11"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Temps de jeu par heure" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid Height="190">
                        <Border Height="1" VerticalAlignment="Top" Margin="0,18,0,0" Background="{StaticResource BorderBrush}" Opacity="0.6" />
                        <Border Height="1" VerticalAlignment="Top" Margin="0,93,0,0" Background="{StaticResource BorderBrush}" Opacity="0.6" />
                        <Border Height="1" VerticalAlignment="Top" Margin="0,168,0,0" Background="{StaticResource BorderBrush}" />
                        <ItemsControl ItemsSource="{Binding Hours}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Background="Transparent" ToolTip="{Binding Tooltip}">
                                        <TextBlock x:Name="hour" DockPanel.Dock="Bottom" Text="{Binding Label}" Style="{StaticResource Muted}"
                                                   FontSize="10" HorizontalAlignment="Left" Height="22" Padding="0,6,0,0" />
                                        <Border x:Name="bar" Height="{Binding BarHeight}" MaxWidth="30" Margin="2,0" VerticalAlignment="Bottom"
                                                CornerRadius="4,4,1,1" Background="{StaticResource BarGradient}" Opacity="0.7" />
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="bar" Property="Opacity" Value="1" />
                                            <Setter TargetName="bar" Property="Background" Value="{StaticResource SuccessBrush}" />
                                            <Setter TargetName="hour" Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bar" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Aucune partie ce jour-là" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,0,0,22" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Jeux joués ce jour-là (masqué quand la page est limitée à un jeu) -->
                <Border Padding="12,18,12,12" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowGames}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Jeux joués" Style="{StaticResource H2}" Margin="6,0,0,8" />
                        <TextBlock Text="Aucun jeu." Style="{StaticResource Muted}" Margin="6,0,0,0"
                                   Visibility="{Binding Games.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Games}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowItem}" Margin="0,0,0,2"
                                            Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding UniverseId}">
                                        <DockPanel Margin="6,7">
                                            <TextBlock x:Name="rank" Text="{Binding Rank}" Width="22" FontWeight="Bold" FontSize="14"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Center" />
                                            <c:GameImage Width="42" Height="42" ImagePath="{Binding IconPath}" Title="{Binding Name}"
                                                         DecodeWidth="96" Margin="6,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Total, Converter={StaticResource Duration}}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <ProgressBar Style="{StaticResource Meter}" Value="{Binding Ratio, Mode=OneWay}" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Rank}" Value="1">
                                            <Setter TargetName="rank" Property="Foreground" Value="{StaticResource StarBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Sessions de la journée -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,18,12,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Sessions" Style="{StaticResource H2}" Margin="6,0,0,8" />
                        <TextBlock Text="Aucune session." Style="{StaticResource Muted}" Margin="6,0,0,0"
                                   Visibility="{Binding Sessions.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowItem}" Margin="0,0,0,2"
                                            Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding UniverseId}">
                                        <DockPanel Margin="6,7">
                                            <c:GameImage Width="42" Height="42" ImagePath="{Binding IconPath}" Title="{Binding GameName}" DecodeWidth="96" />
                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Duration, Converter={StaticResource Duration}}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" />
                                                <Border Style="{StaticResource Pill}" Padding="6,1" Margin="0,3,0,0" HorizontalAlignment="Right"
                                                        Background="#2622C55E" Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="En cours" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0">
                                                    <Run Text="{Binding StartUtc, Converter={StaticResource LocalDate}, ConverterParameter='HH:mm', Mode=OneWay}" /><Run
                                                         Text=" → " /><Run Text="{Binding EndUtc, Converter={StaticResource LocalDate}, ConverterParameter='HH:mm', Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
