<UserControl x:Class="RobloxTracker.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RobloxTracker.App.Controls">
    <DockPanel Margin="32,28,20,0">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,12,0">
            <TextBlock Text="Bibliothèque" Style="{StaticResource H1}" Margin="0" />
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Subtitle}" />

            <!-- Filtres -->
            <WrapPanel Margin="0,0,0,8">
                <Grid Width="230" Height="34" Margin="0,0,8,8">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="Rechercher un jeu ou un créateur…" Style="{StaticResource Muted}" FontSize="13"
                               Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                </Grid>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,8,8" MinWidth="140" />
                <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Margin="0,0,8,8" MinWidth="130" />
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Margin="0,0,8,8" MinWidth="130"
                          ToolTip="Trier par" />
                <CheckBox Content="Favoris uniquement" IsChecked="{Binding FavoritesOnly}" Margin="4,0,8,8" VerticalAlignment="Center" />
                <Button Style="{StaticResource GhostButton}" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,8" Padding="8,6"
                        ToolTip="Réinitialiser les filtres">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE894;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="Réinitialiser" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>

        <Grid>
            <TextBlock Text="Aucun jeu ne correspond. Joue à une expérience Roblox ou modifie les filtres."
                       Style="{StaticResource Muted}" FontSize="14" Margin="0,24"
                       Visibility="{Binding Games.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />

            <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" SizeChanged="RowsList_SizeChanged"
                          Style="{StaticResource VirtualList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding}">
                            <!-- Les cartes s'étirent pour occuper toute la largeur -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"
                                                 Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ClickableItem}" Margin="0,0,12,12"
                                            Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding UniverseId}">
                                        <StackPanel>
                                            <Grid Height="140">
                                                <c:GameImage ImagePath="{Binding ThumbnailPath}" Title="{Binding Name}" DecodeWidth="480"
                                                             CornerRadius="11,11,0,0" />
                                                <Border Background="{StaticResource ImageScrim}" CornerRadius="11,11,0,0" />
                                                <c:GameImage Width="46" Height="46" ImagePath="{Binding IconPath}" Title="{Binding Name}" DecodeWidth="96"
                                                             HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,-14" CornerRadius="10"
                                                             BorderBrush="{StaticResource SurfaceBrush}" BorderThickness="2" />
                                                <!-- Temps de jeu en surimpression -->
                                                <Border Background="#B30D0F14" CornerRadius="8" Padding="8,3" Margin="0,0,10,10"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Total, Converter={StaticResource Duration}}" FontWeight="SemiBold"
                                                                   FontSize="12" Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#99000000" CornerRadius="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                                    <ToggleButton Style="{StaticResource StarToggle}" IsChecked="{Binding IsFavorite}" Foreground="White" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Margin="14,22,14,14">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" ToolTip="{Binding Name}" />
                                                <TextBlock Text="{Binding CreatorName, StringFormat='par {0}'}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                                <DockPanel Margin="0,10,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SessionCount, StringFormat='{}{0} sessions'}"
                                                               Style="{StaticResource Muted}" Margin="8,0,0,0" />
                                                    <TextBlock Text="{Binding LastPlayedUtc, Converter={StaticResource LocalDate}, ConverterParameter='\'Joué le\' d MMM yyyy'}"
                                                               Style="{StaticResource Muted}" />
                                                </DockPanel>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Border CornerRadius="9" Padding="8,2" Margin="0,0,4,0"
                                                            Background="{Binding CategoryColor, Converter={StaticResource HexBrush}}"
                                                            Visibility="{Binding CategoryName, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="White" />
                                                    </Border>
                                                    <Border CornerRadius="9" Padding="8,2" Background="{StaticResource SurfaceHoverBrush}"
                                                            Visibility="{Binding GroupNames, Converter={StaticResource Vis}}" MaxWidth="200">
                                                        <TextBlock Text="{Binding GroupNames}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DockPanel>
</UserControl>
