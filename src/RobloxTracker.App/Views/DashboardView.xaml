<UserControl x:Class="RobloxTracker.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RobloxTracker.App.Controls"
             xmlns:v="clr-namespace:RobloxTracker.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <!-- En-tête -->
            <TextBlock Style="{StaticResource H1}" Margin="0">
                <Run Text="{Binding Greeting, Mode=OneWay}" /><Run Text=" 👋" />
            </TextBlock>
            <TextBlock Text="{Binding DateText}" Style="{StaticResource Subtitle}" />

            <!-- Chiffres clés -->
            <UniformGrid Columns="4" Margin="-6,0,-6,0">
                <HeaderedContentControl Style="{StaticResource StatCard}" Header="Aujourd'hui" Tag="&#xE916;"
                                        Foreground="{StaticResource SuccessBrush}">
                    <TextBlock Text="{Binding Today, Converter={StaticResource Duration}}" Style="{StaticResource BigNumber}" FontSize="21" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource StatCard}" Header="7 derniers jours" Tag="&#xE787;"
                                        Foreground="{StaticResource AccentBrush}">
                    <TextBlock Text="{Binding Week, Converter={StaticResource Duration}}" Style="{StaticResource BigNumber}" FontSize="21" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource StatCard}" Header="Temps total" Tag="&#xE823;"
                                        Foreground="{StaticResource Accent2Brush}">
                    <TextBlock Text="{Binding Total, Converter={StaticResource Duration}}" Style="{StaticResource BigNumber}" FontSize="21" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource StatCard}" Header="Jeux suivis" Tag="&#xE7FC;"
                                        Foreground="{StaticResource OrangeBrush}">
                    <TextBlock Text="{Binding GameCount}" Style="{StaticResource BigNumber}" FontSize="21" />
                </HeaderedContentControl>
            </UniformGrid>

            <!-- État vide -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                    Visibility="{Binding GameCount, Converter={StaticResource Vis}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center" Margin="0,24">
                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="Aucune partie enregistrée pour l'instant" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="Lance une expérience Roblox : elle apparaîtra ici automatiquement, avec son image et ton temps de jeu."
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Graphe 14 jours -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Aujourd'hui" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Temps de jeu — 14 derniers jours" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- Barres max 150 px + 18 px d'étiquette au-dessus + 22 px de date en dessous -->
                    <Grid Height="190">
                        <Border Height="1" VerticalAlignment="Top" Margin="0,18,0,0" Background="{StaticResource BorderBrush}" Opacity="0.6" />
                        <Border Height="1" VerticalAlignment="Top" Margin="0,93,0,0" Background="{StaticResource BorderBrush}" Opacity="0.6" />
                        <Border Height="1" VerticalAlignment="Top" Margin="0,168,0,0" Background="{StaticResource BorderBrush}" />
                        <ItemsControl ItemsSource="{Binding Daily}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Background="Transparent" ToolTip="{Binding Tooltip}">
                                        <TextBlock x:Name="day" DockPanel.Dock="Bottom" Text="{Binding Label}" Style="{StaticResource Muted}"
                                                   FontSize="11" HorizontalAlignment="Center" Height="22" Padding="0,6,0,0" />
                                        <StackPanel VerticalAlignment="Bottom">
                                            <TextBlock x:Name="value" Text="{Binding ValueText}" Style="{StaticResource Muted}" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,0,0,4" />
                                            <Border x:Name="bar" Height="{Binding BarHeight}" MaxWidth="34" Margin="6,0"
                                                    CornerRadius="5,5,1,1" Background="{StaticResource BarGradient}" Opacity="0.55" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="bar" Property="Opacity" Value="1" />
                                            <Setter TargetName="bar" Property="Background" Value="{StaticResource SuccessBrush}" />
                                            <Setter TargetName="value" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Setter TargetName="day" Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Setter TargetName="day" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bar" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Statistiques par mois / année -->
            <v:PeriodStatsView DataContext="{Binding Period}" Margin="0,12,0,0" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Jeux les plus joués -->
                <Border Style="{StaticResource Card}" Padding="12,18,12,12">
                    <StackPanel>
                        <TextBlock Text="Jeux les plus joués" Style="{StaticResource H2}" Margin="6,0,0,8" />
                        <ItemsControl ItemsSource="{Binding TopGames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowItem}" Margin="0,0,0,2"
                                            Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Card.UniverseId}">
                                        <DockPanel Margin="6,7">
                                            <TextBlock x:Name="rank" Text="{Binding Rank}" Width="22" FontWeight="Bold" FontSize="14"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Center" />
                                            <c:GameImage Width="42" Height="42" ImagePath="{Binding Card.IconPath}" Title="{Binding Card.Name}"
                                                         DecodeWidth="96" Margin="6,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Card.Total, Converter={StaticResource Duration}}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Card.Name}" FontWeight="SemiBold" />
                                                <ProgressBar Style="{StaticResource Meter}" Value="{Binding Ratio, Mode=OneWay}" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Rank}" Value="1">
                                            <Setter TargetName="rank" Property="Foreground" Value="{StaticResource StarBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Sessions récentes -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,18,12,12">
                    <StackPanel>
                        <TextBlock Text="Sessions récentes" Style="{StaticResource H2}" Margin="6,0,0,8" />
                        <ItemsControl ItemsSource="{Binding RecentSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowItem}" Margin="0,0,0,2"
                                            Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding UniverseId}">
                                        <DockPanel Margin="6,7">
                                            <c:GameImage Width="42" Height="42" ImagePath="{Binding IconPath}" Title="{Binding GameName}" DecodeWidth="96" />
                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Duration, Converter={StaticResource Duration}}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" />
                                                <Border Style="{StaticResource Pill}" Padding="6,1" Margin="0,3,0,0" HorizontalAlignment="Right"
                                                        Background="#2622C55E" Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="En cours" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StartUtc, Converter={StaticResource LocalDate}, ConverterParameter='dddd d MMM, HH:mm'}"
                                                           Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
