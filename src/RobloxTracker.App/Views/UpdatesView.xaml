<UserControl x:Class="RobloxTracker.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RobloxTracker.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding CheckNowCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                        <TextBlock Text="Vérifier maintenant" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Mises à jour" Style="{StaticResource H1}" />
            </DockPanel>

            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Text="Les infos des jeux suivis sont rafraîchies automatiquement. « Nouveau » = publiée après ta dernière partie." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox Content="Favoris uniquement" IsChecked="{Binding FavoritesOnly}" Margin="0,0,20,0" />
                <CheckBox IsChecked="{Binding NewOnly}">
                    <TextBlock Text="{Binding NewCount, StringFormat='Nouvelles uniquement ({0})'}" />
                </CheckBox>
                <TextBlock Text="Vérification en cours…" Style="{StaticResource Muted}" Margin="20,0,0,0"
                           Visibility="{Binding IsChecking, Converter={StaticResource Vis}}" />
            </StackPanel>

            <TextBlock Text="Aucune mise à jour à afficher." Style="{StaticResource Muted}" FontSize="14"
                       Visibility="{Binding Items.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ClickableItem}" Margin="0,0,0,8"
                                Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding UniverseId}">
                            <DockPanel Margin="12,10">
                                <c:GameImage Width="48" Height="48" ImagePath="{Binding IconPath}" Title="{Binding GameName}" DecodeWidth="96" />
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding UpdatedOnRoblox, Converter={StaticResource LocalDate}, ConverterParameter='d MMM yyyy, HH:mm'}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding DetectedUtc, Converter={StaticResource LocalDate}, ConverterParameter='\'détectée le\' d MMM'}"
                                               Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource StarBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource Vis}}" />
                                        <Border Background="{StaticResource SuccessBrush}" CornerRadius="9" Padding="8,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsNewSinceLastPlay, Converter={StaticResource Vis}}">
                                            <TextBlock Text="Nouveau" FontSize="11" FontWeight="SemiBold" Foreground="#0F1115" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
