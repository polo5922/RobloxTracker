<UserControl x:Class="RobloxTracker.App.Views.PeriodStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RobloxTracker.App.Controls">
    <!-- DataContext : PeriodStatsViewModel -->
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <!-- En-tête : titre + sélecteur de période -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="Mois" IsChecked="True" />
                            <RadioButton Style="{StaticResource Segment}" Content="Année" IsChecked="{Binding IsYearMode}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding PreviousCommand}" Padding="8" ToolTip="Période précédente">
                        <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                    </Button>
                    <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" MinWidth="120" Margin="4,0"
                              Visibility="{Binding IsYearMode, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" MinWidth="84" Margin="4,0" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding NextCommand}" Padding="8" ToolTip="Période suivante">
                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Statistiques par période" Style="{StaticResource H2}" Margin="0" />
                    <TextBlock Text="{Binding PeriodTitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Chiffres clés de la période -->
            <UniformGrid Columns="4" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Temps de jeu" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Total, Converter={StaticResource Duration}}" FontSize="20" FontWeight="Bold" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding DeltaText}" FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding DeltaText, Converter={StaticResource Vis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeltaUp}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Sessions" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding SessionCount}" FontSize="20" FontWeight="Bold" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Jours joués" Style="{StaticResource Muted}" />
                    <TextBlock FontSize="20" FontWeight="Bold" Margin="0,3,0,0">
                        <Run Text="{Binding DaysPlayed, Mode=OneWay}" /><Run Text="{Binding DaysInPeriod, Mode=OneWay, StringFormat=' / {0}'}"
                                                                          FontSize="13" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Moyenne par jour joué" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding AveragePerDay, Converter={StaticResource Duration}}" FontSize="20" FontWeight="Bold" Margin="0,3,0,0" />
                </StackPanel>
            </UniformGrid>

            <!-- Graphe : barres max 150 px + 18 px d'étiquette au-dessus + 22 px d'axe en dessous -->
            <Grid Height="190">
                <Border Height="1" VerticalAlignment="Top" Margin="0,18,0,0" Background="{StaticResource BorderBrush}" Opacity="0.6" />
                <Border Height="1" VerticalAlignment="Top" Margin="0,93,0,0" Background="{StaticResource BorderBrush}" Opacity="0.6" />
                <Border Height="1" VerticalAlignment="Top" Margin="0,168,0,0" Background="{StaticResource BorderBrush}" />
                <ItemsControl ItemsSource="{Binding Bars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BarButton}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.SelectBarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <DockPanel Background="Transparent" ToolTip="{Binding Tooltip}">
                                    <TextBlock x:Name="day" DockPanel.Dock="Bottom" Text="{Binding Label}" Style="{StaticResource Muted}"
                                               FontSize="10" HorizontalAlignment="Center" Height="22" Padding="0,6,0,0" />
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock x:Name="value" Text="{Binding ValueText}" Style="{StaticResource Muted}" FontSize="10"
                                                   HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <Border x:Name="bar" Height="{Binding BarHeight}" MaxWidth="34" Margin="2,0"
                                                CornerRadius="4,4,1,1" Background="{StaticResource BarGradient}" Opacity="0.55" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="bar" Property="Opacity" Value="1" />
                                    <Setter TargetName="bar" Property="Background" Value="{StaticResource SuccessBrush}" />
                                    <Setter TargetName="value" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Setter TargetName="day" Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="day" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bar" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Aucune partie sur cette période" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Margin="0,0,0,22" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" />
            </Grid>
            <TextBlock Text="{Binding BestText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                       Visibility="{Binding BestText, Converter={StaticResource Vis}}" />

            <!-- Jeux les plus joués sur la période (tableau de bord uniquement) -->
            <StackPanel Margin="0,16,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowTopGames}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TopGames.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Jeux les plus joués sur la période" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding TopGames}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowItem}" Margin="-6,0,-6,2"
                                    Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding UniverseId}">
                                <DockPanel Margin="6,6">
                                    <TextBlock x:Name="rank" Text="{Binding Rank}" Width="22" FontWeight="Bold" FontSize="14"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Center" />
                                    <c:GameImage Width="36" Height="36" ImagePath="{Binding IconPath}" Title="{Binding Name}"
                                                 DecodeWidth="80" Margin="6,0,0,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Total, Converter={StaticResource Duration}}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding Ratio, Mode=OneWay}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Rank}" Value="1">
                                    <Setter TargetName="rank" Property="Foreground" Value="{StaticResource StarBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
