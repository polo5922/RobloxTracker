<Window x:Class="RobloxTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:RobloxTracker.App.Controls"
        Title="Roblox Tracker" Icon="Assets/app.ico" Width="1280" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Point vert qui « respire » pendant une partie -->
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9" />
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu latéral -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,28">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Roblox Tracker" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="Temps de jeu" Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Partie en cours : vignette du jeu en fond -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource ClickableItem}" Command="{Binding OpenActiveGameCommand}"
                        Visibility="{Binding ActiveSession, Converter={StaticResource Vis}}" ToolTip="Ouvrir la fiche du jeu">
                    <Grid ClipToBounds="True">
                        <c:GameImage ImagePath="{Binding ActiveSession.ThumbnailPath}" Title=" " DecodeWidth="320" CornerRadius="11" />
                        <Border Background="{StaticResource SideScrim}" CornerRadius="11" />
                        <StackPanel Margin="12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource Pulse}" />
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="EN JEU" Margin="7,0,0,0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                            <DockPanel>
                                <c:GameImage Width="42" Height="42" ImagePath="{Binding ActiveSession.IconPath}"
                                             Title="{Binding ActiveSession.GameName}" DecodeWidth="96" />
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveSession.GameName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ElapsedText}" FontFamily="Cascadia Mono, Consolas" FontSize="16"
                                               FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Button>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,10"
                        Visibility="{Binding ActiveSession, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource MutedBrush}" Opacity="0.6" />
                        <TextBlock Text="Aucun jeu en cours" Style="{StaticResource Muted}" Margin="8,0,0,0" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="22"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page courante, avec un léger fondu + glissement à chaque changement -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}" Focusable="False">
            <ContentControl.RenderTransform>
                <TranslateTransform />
            </ContentControl.RenderTransform>
            <ContentControl.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="10" To="0"
                                             Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ContentControl.Triggers>
        </ContentControl>
    </Grid>
</Window>
