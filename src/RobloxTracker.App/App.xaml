<Application x:Class="RobloxTracker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RobloxTracker.App.Converters"
             xmlns:vm="clr-namespace:RobloxTracker.App.ViewModels"
             xmlns:views="clr-namespace:RobloxTracker.App.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:DurationConverter x:Key="Duration" />
            <conv:LocalDateConverter x:Key="LocalDate" />
            <conv:HexToBrushConverter x:Key="HexBrush" />
            <conv:VisibilityConverter x:Key="Vis" />

            <!-- Chaque ViewModel de page s'affiche avec sa vue -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><views:LibraryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:GameDetailViewModel}"><views:GameDetailView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DayDetailViewModel}"><views:DayDetailView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UpdatesViewModel}"><views:UpdatesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:OrganizeViewModel}"><views:OrganizeView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
